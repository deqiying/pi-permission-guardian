{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/deqiying/pi-permission-guardian/main/schemas/guardian.schema.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "本文件的 schema 位置，用于编辑器补全与校验"
    },
    "enabled": {
      "default": true,
      "description": "总开关。关闭后 tool_call 直接放行，等同未安装。",
      "type": "boolean"
    },
    "yoloMode": {
      "default": false,
      "description": "逃生舱：把所有 ask / review 重写为 allow（FR-53）。开启时状态栏必须显著提示。",
      "type": "boolean"
    },
    "auditLog": {
      "default": {
        "enabled": true,
        "retentionDays": 14
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "description": "是否写入决策审计日志。",
          "type": "boolean"
        },
        "retentionDays": {
          "default": 14,
          "description": "保留的自然日数量，包含当天。启动及跨日写入前清理更早的 guardian-日期.jsonl。",
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        }
      },
      "additionalProperties": false,
      "description": "决策审计日志（FR-43/44）。固定按进程本地日期切分，文件名为 guardian-YYYY-MM-DD.jsonl。"
    },
    "debugLog": {
      "default": false,
      "description": "调试日志：额外记录 facts 全文与评审提示词，可能含会话内容，默认关闭。",
      "type": "boolean"
    },
    "gate": {
      "default": "side-effect",
      "description": "评估范围（architecture §4.0）。side-effect=全部 pi 内置工具；all=额外包含自定义工具与 MCP 工具。它决定哪些调用进入规则求值，不是哪些会被拦截。",
      "type": "string",
      "enum": [
        "side-effect",
        "all"
      ]
    },
    "extraTools": {
      "default": [],
      "description": "在 gate 之外额外评估的工具名，例如 subagent。",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "onReviewUnavailable": {
      "default": "deny",
      "description": "评审不可用（超时 / 模型报错 / 输出非法 / 模型未配置）时的动作（FR-19、§9）。默认 deny；可显式配 allow。",
      "$ref": "#/$defs/failureBranchAction"
    },
    "onUnresolvedFacts": {
      "default": "review",
      "description": "facts 不可信（bash 解析失败、包装器内部不可展开、路径非字面量）时的动作（FR-12、FR-14、FR-15）。默认 review；可显式配 allow。",
      "$ref": "#/$defs/failureBranchAction"
    },
    "onAskWithoutUI": {
      "default": "deny",
      "description": "需要人工确认但没有交互界面（print / json 模式、后台子代理）时的动作（FR-46）。默认 deny；可显式配 allow。",
      "$ref": "#/$defs/failureBranchAction"
    },
    "onMixedCommandActions": {
      "default": "deny",
      "description": "同一 shell 调用的多个已解析命令单元同时得到 allow 与 deny 时的调用级动作（FR-59）。不能配置为 allow；global/default 定义基线，project 仅能按 deny > ask > review 收紧。",
      "type": "string",
      "enum": [
        "deny",
        "ask",
        "review"
      ]
    },
    "reviewer": {
      "default": {
        "reasoningEffort": null,
        "timeoutMs": 20000,
        "maxEvidenceRounds": 3,
        "evidenceTools": true,
        "transcript": true,
        "transcriptBudgetChars": 24000,
        "maxAllowRiskLevel": "medium"
      },
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 3,
          "pattern": "^[^/]+\\/.+$",
          "description": "评审模型，格式 \"provider/model-id\"，只能引用 pi 模型配置文件中已存在的模型。通过 model registry 解析并使用模型配置的接口协议；插件不接受 api/baseUrl/认证/headers 覆盖。未配置或无法解析即 unavailable（FR-19、D6）。"
        },
        "reasoningEffort": {
          "default": null,
          "description": "评审调用的推理强度；null 表示不发送推理参数。级别会先按模型 thinkingLevelMap 归一，再交给该模型协议的请求字段；配置了但该协议表达不了（google / mistral）即 unavailable，不静默忽略。",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "timeoutMs": {
          "default": 20000,
          "description": "单次评审的硬性 deadline（FR-25）",
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        },
        "maxEvidenceRounds": {
          "default": 3,
          "description": "评审模型调用只读证据工具自行查证的轮次上限（FR-24）",
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "evidenceTools": {
          "default": true,
          "description": "是否允许评审模型调用只读证据工具（read / grep / find / ls）",
          "type": "boolean"
        },
        "transcript": {
          "default": true,
          "description": "是否把会话 transcript 提供给评审模型",
          "type": "boolean"
        },
        "transcriptBudgetChars": {
          "default": 24000,
          "description": "transcript 的字符预算上限",
          "type": "integer",
          "minimum": 2000,
          "maximum": 9007199254740991
        },
        "maxAllowRiskLevel": {
          "default": "medium",
          "description": "风险等级门槛（FR-23）：模型给出 allow 但 riskLevel 高于此值时，不直接放行，转为人工确认。",
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        }
      },
      "additionalProperties": false,
      "description": "评审模型配置（FR-19~FR-28）"
    },
    "userBashPolicy": {
      "default": {
        "enabled": true,
        "autoReview": true,
        "reasoningEffort": null,
        "model": null
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "description": "是否拦截 user_bash。关闭后用户直接执行的命令不经过本插件。",
          "type": "boolean"
        },
        "autoReview": {
          "default": true,
          "description": "user_bash 得到 review 动作时是否自动调用评审模型；关闭后转人工确认。",
          "type": "boolean"
        },
        "reasoningEffort": {
          "default": null,
          "description": "user_bash 自动审核的推理强度；null 表示不发送推理参数（与 reviewer.reasoningEffort 各自独立，不随 model 回落）。",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "default": null,
          "description": "user_bash 自动审核模型，格式 provider/model-id；只能引用 pi 模型配置中的模型，接口协议使用该模型自己的配置；null 表示复用 reviewer.model。",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[^/]+\\/.+$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "description": "用户直接输入 !command / !!command 时的护栏策略（FR-60）。两者采用相同安全裁决，区别仅是 !! 的输出不进入模型上下文。"
    },
    "classifier": {
      "default": {
        "enabled": false,
        "model": null,
        "reasoningEffort": null,
        "timeoutMs": 15000,
        "maxLag": 2
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "model": {
          "default": null,
          "description": "缺省复用 reviewer.model",
          "type": [
            "string",
            "null"
          ]
        },
        "reasoningEffort": {
          "default": null,
          "description": "预评分调用的推理强度；null 表示不发送推理参数。预评分是“先放行、后判定”的便宜路径，默认不继承评审强度（FR-36~38）。",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "timeoutMs": {
          "default": 15000,
          "type": "integer",
          "minimum": 1000,
          "maximum": 9007199254740991
        },
        "maxLag": {
          "default": 2,
          "description": "评分对应的调用序落后当前超过此值时，快路径失效（FR-37）",
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        }
      },
      "additionalProperties": false,
      "description": "非阻塞预评分（FR-36~38）。语义是\"先放行、后判定\"，默认关闭（D8）。开启后只会放行、永不拒绝。"
    },
    "circuitBreaker": {
      "default": {
        "consecutiveDenials": 3,
        "recentDenials": 10,
        "windowSize": 50
      },
      "type": "object",
      "properties": {
        "consecutiveDenials": {
          "default": 3,
          "description": "同一轮内连续拒绝达到此值时拦截并提前结束本轮",
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "recentDenials": {
          "default": 10,
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "windowSize": {
          "default": 50,
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "additionalProperties": false,
      "description": "熔断器（FR-34/35）。阈值设为 0 表示关闭该条件。"
    },
    "cache": {
      "default": {
        "enabled": true,
        "ttlMs": 300000,
        "maxEntries": 200
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "ttlMs": {
          "default": 300000,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxEntries": {
          "default": 200,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false,
      "description": "判定缓存（FR-31~33）。仅内存，仅缓存确定的 allow / deny，不缓存 unavailable。"
    },
    "sessionGrants": {
      "default": {
        "enabled": true
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "description": "会话授权记忆（FR-29/30）。仅内存，会话结束即失效，不落盘。"
    },
    "subagentPolicy": {
      "default": {
        "enabled": true,
        "defaultAction": "review",
        "allowSessionGrants": false
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "description": "检测到子代理会话时是否启用该策略。",
          "type": "boolean"
        },
        "defaultAction": {
          "default": "review",
          "description": "子代理中规则未命中时使用的默认动作；与默认动作矩阵取最严格者，因此只可能收紧；不允许 allow。",
          "type": "string",
          "enum": [
            "deny",
            "ask",
            "review"
          ]
        },
        "allowSessionGrants": {
          "default": false,
          "description": "子代理是否能创建或使用会话授权；默认 false，且父子会话状态始终不共享。",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "description": "子代理会话的保守策略（FR-56）。v1 仅对接 @gotgenes/pi-subagents v21.7.1；只收紧默认动作矩阵，不影响用户显式规则、只读白名单与 onUnresolvedFacts。"
    },
    "workingDirectory": {
      "default": {
        "allowRoots": [],
        "readOnly": {
          "profiles": [
            "search",
            "vcs-read",
            "nav",
            "text-read",
            "print",
            "system"
          ],
          "commands": [],
          "unsafeOptions": [],
          "sinks": []
        },
        "readOnlyCommands": [
          "pwd",
          "ls",
          "cat",
          "head",
          "tail",
          "wc",
          "git status",
          "git diff",
          "git log",
          "git show"
        ]
      },
      "type": "object",
      "properties": {
        "allowRoots": {
          "default": [],
          "description": "视为\"内部\"的额外根目录。monorepo 场景可加入兄弟包路径，避免被判定为外部目录。",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "readOnly": {
          "default": {
            "profiles": [
              "search",
              "vcs-read",
              "nav",
              "text-read",
              "print",
              "system"
            ],
            "commands": [],
            "unsafeOptions": [],
            "sinks": []
          },
          "type": "object",
          "properties": {
            "profiles": {
              "default": [
                "search",
                "vcs-read",
                "nav",
                "text-read",
                "print",
                "system"
              ],
              "description": "启用的内置档案分组，默认 [\"search\",\"vcs-read\",\"nav\",\"text-read\",\"print\",\"system\"]。可选：search（rg/grep/find）、vcs-read（git 只读子命令）、nav（cd/pushd，仅限项目内目录）、text-read（cat/head/ls/stat…）、print（echo/printf）、system（date/du/df/which/ps…）、text-tools（sort/diff/jq…）、meta（版本查询）。配 [] 表示不使用任何内置档案，只用自己的 commands。",
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "search",
                  "vcs-read",
                  "nav",
                  "text-read",
                  "print",
                  "system",
                  "text-tools",
                  "meta"
                ]
              }
            },
            "commands": {
              "default": [],
              "description": "自定义只读命令档案：字符串或对象。排在分组前面，因此可以压住内置档案。",
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "object",
                    "properties": {
                      "argv": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "description": "argv 前缀（可执行名 + 参数），与字符串条目同语义；写一条更具体的条目可以压住内置档案（先到先得）。"
                      },
                      "roles": {
                        "description": "位置参数角色序列，缺省 [\"paths\"]。最后一项吸收剩余位置参数；空数组表示不允许位置参数（`git branch <新分支名>` 这类会被取消免评审）。",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "pattern",
                            "paths",
                            "script"
                          ],
                          "description": "位置参数的角色的取值：pattern（模式/正则，不是文件）、paths（文件路径，产出 read 目标）、script（脚本代码，必须整体命中 `script` 模式集）。"
                        }
                      },
                      "script": {
                        "description": "仅 script 角色使用：整体锚定的正则白名单，不匹配即取消免评审。例如 sed 的 [\"^[0-9]+(,[0-9]+)?p$\"]。",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "optionPolicy": {
                        "description": "选项策略，缺省 deny-list（未列出的选项默认安全）。危险选项密集的命令（find / git branch）应使用 allow-list：只有 safeOptions 列出的选项才安全。",
                        "type": "string",
                        "enum": [
                          "deny-list",
                          "allow-list"
                        ]
                      },
                      "safeOptions": {
                        "description": "allow-list 下视为安全的选项；在 deny-list 下同时豁免“值像路径的 --opt=value”形状规则。",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "unsafeOptions": {
                        "description": "命中即取消免评审的选项（写文件 / 执行程序 / 改工作目录）。按词前缀匹配（--pre 同时覆盖 --pre-glob）。",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "onlyWithinRoots": {
                        "description": "免评审要求目标必须在项目根目录内（缺省 false）。用于 cd / pushd 这类“去哪里”的命令：必须在至少一个位置参数，且全部路径目标都非 external，否则不免评审。",
                        "type": "boolean"
                      },
                      "reason": {
                        "description": "人类可读依据，展示在审计与人工确认提示里。",
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "argv"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "unsafeOptions": {
              "default": [],
              "description": "用户级全局选项黑名单：对所有档案（含内置分组与 readOnlyCommands 条目）生效，按词前缀匹配，命中即取消免评审。只收紧，不放宽。",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "sinks": {
              "default": [],
              "description": "额外的“写入不算副作用”的目标（FR-67）。内置空设备 /dev/null 与 NUL 总是生效，这里只做追加。",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false,
          "description": "结构化只读命令档案（FR-65~FR-67）。与旧的字符串白名单 readOnlyCommands 并存：旧键语义不变，新键补充参数角色与选项名单。"
        },
        "readOnlyCommands": {
          "default": [
            "pwd",
            "ls",
            "cat",
            "head",
            "tail",
            "wc",
            "git status",
            "git diff",
            "git log",
            "git show"
          ],
          "description": "只读命令白名单（FR-9）：命中即 allow，不产生评审调用。内置集保持尽可能小且通用，匹配固定为“可执行名 + 参数前缀”，不为特殊选项增加分支。省略时使用内置集；显式配置数组时完整覆盖默认集，配置 [] 可关闭。例如 \"git status\" 匹配 `git status --short`，不匹配 `git push`。需要更精确的归因（模式不是路径、选项黑名单、脚本白名单）请用 readOnly。",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "permission": {
      "default": {},
      "type": "object",
      "properties": {
        "*": {
          "description": "通用兜底。未设置时按 surface 默认矩阵裁决：读取类 allow，其余 review。一旦设置，会覆盖全部默认值。",
          "$ref": "#/$defs/surfaceValue"
        },
        "path": {
          "description": "敏感路径（语法糖，展开为 path_read + path_write，方向独立判定）",
          "$ref": "#/$defs/surfaceValue"
        },
        "external_directory": {
          "description": "工作目录之外（语法糖，展开为 external_directory_read + external_directory_write）",
          "$ref": "#/$defs/surfaceValue"
        },
        "path_read": {
          "$ref": "#/$defs/surfaceValue"
        },
        "path_write": {
          "$ref": "#/$defs/surfaceValue"
        },
        "external_directory_read": {
          "$ref": "#/$defs/surfaceValue"
        },
        "external_directory_write": {
          "$ref": "#/$defs/surfaceValue"
        },
        "bash": {
          "$ref": "#/$defs/surfaceValue"
        },
        "powershell": {
          "$ref": "#/$defs/surfaceValue"
        },
        "read": {
          "$ref": "#/$defs/surfaceValue"
        },
        "write": {
          "$ref": "#/$defs/surfaceValue"
        },
        "edit": {
          "$ref": "#/$defs/surfaceValue"
        },
        "find": {
          "$ref": "#/$defs/surfaceValue"
        },
        "grep": {
          "$ref": "#/$defs/surfaceValue"
        },
        "ls": {
          "$ref": "#/$defs/surfaceValue"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/surfaceValue"
      },
      "title": "规则表",
      "description": "按 surface 组织。键可以是 \"*\"、path / external_directory 语法糖、方向键（*_read / *_write）、内置工具名（read / write / edit / find / grep / ls / bash / powershell）或任意已注册工具名。值可以是单个动作，也可以是模式到动作的映射。"
    }
  },
  "additionalProperties": false,
  "title": "pi-permission-guardian 配置",
  "description": "pi-permission-guardian 扩展的配置结构。字段语义见 docs/configuration.md，需求依据见 docs/requirements.md。所有字段均可省略，因为全局层与项目层是合并的，局部配置必须能独立通过校验。",
  "$defs": {
    "failureBranchAction": {
      "type": "string",
      "enum": [
        "deny",
        "ask",
        "review",
        "allow"
      ],
      "title": "失败分支动作",
      "description": "默认 fail-closed；允许显式配 allow（等同就地放宽护栏，请优先考虑 yoloMode）"
    },
    "actionValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/action"
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "$ref": "#/$defs/action"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "description": "在拦截信息中向 agent 展示的理由（FR-10）"
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false,
          "title": "带理由的动作"
        }
      ],
      "title": "动作或带理由的动作"
    },
    "action": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "ask",
        "review"
      ],
      "title": "动作",
      "description": "allow=静默放行；deny=直接拒绝；ask=人工确认；review=交评审模型判断"
    },
    "ruleMap": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/actionValue"
      },
      "title": "模式到动作的映射",
      "description": "键为 glob 模式（* 跨路径分隔符，? 单字符，结尾 \" *\" 使参数可选）。同一 surface 内后写的规则覆盖先写的（last-match-wins，FR-5）。"
    },
    "surfaceValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/actionValue"
        },
        {
          "$ref": "#/$defs/ruleMap"
        }
      ],
      "title": "面规则"
    }
  }
}
