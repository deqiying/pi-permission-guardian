{
  "name": "pi-permission-guardian",
  "version": "0.1.0",
  "description": "Permission guardrail extension for the pi coding agent.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deqiying/pi-permission-guardian.git"
  },
  "homepage": "https://github.com/deqiying/pi-permission-guardian#readme",
  "bugs": {
    "url": "https://github.com/deqiying/pi-permission-guardian/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "permissions",
    "policy",
    "security"
  ],
  "files": [
    "extensions",
    "src",
    "schemas",
    "config",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/guardian.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:schema": "node --experimental-strip-types scripts/generate-schema.ts",
    "gen:corpus": "node --experimental-strip-types scripts/gen-bash-corpus.ts",
    "validate:config": "node --experimental-strip-types scripts/validate-config.ts",
    "check:pack": "node --experimental-strip-types scripts/check-pack.ts",
    "prepack": "npm run gen:schema"
  },
  "dependencies": {
    "tree-sitter-bash": "^0.25.1",
    "web-tree-sitter": "^0.26.13",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.85.1",
    "@earendil-works/pi-coding-agent": ">=0.85.1",
    "@earendil-works/pi-tui": ">=0.85.1",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
}
